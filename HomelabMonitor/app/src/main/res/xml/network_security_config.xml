<?xml version="1.0" encoding="utf-8"?>
<!-- Heimnetz-Dienste (Immich, Pi-hole) laufen meist per http:// im LAN -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
